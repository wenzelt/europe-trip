{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wenzelt/europe-trip/blob/master/data/entries.schema.json",
  "title": "Europe Trip Blog Data",
  "type": "object",
  "required": ["schema_version", "trip", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "trip": {
      "type": "object",
      "required": ["title", "subtitle", "locale", "transport", "accommodation", "home"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "transport": { "type": "string", "minLength": 1 },
        "accommodation": { "type": "string", "minLength": 1 },
        "home": { "$ref": "#/$defs/coordinates" }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "coordinates": {
      "type": "object",
      "required": ["name", "lat", "lng"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["name", "country", "country_code", "lat", "lng"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "region": { "type": "string" },
        "country": { "type": "string", "minLength": 1 },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "title", "date", "status", "published", "route_order", "location", "summary", "body", "highlights", "tags", "cover_image", "gallery", "links"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "status": { "enum": ["idee", "geplant", "unterwegs", "besucht"] },
        "published": { "type": "boolean" },
        "route_order": { "type": "integer", "minimum": 1 },
        "location": { "$ref": "#/$defs/location" },
        "summary": { "type": "string", "minLength": 1 },
        "body": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "highlights": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "cover_image": { "type": ["string", "null"] },
        "gallery": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      },
      "additionalProperties": false
    }
  }
}
